# =================================================================
# DARSHANAI — Production & Development Environment Configuration
# =================================================================

# 1. Project Information
PROJECT_NAME="DarshanAI"
VERSION="1.0.0"
API_V1_STR="/api"

# 2. Database Connection (PostgreSQL for Production / SQLite for Local Dev)
# Production PostgreSQL Example:
# DATABASE_URL=postgresql://darshan_user:SecurePassword123!@localhost:5432/darshanai_db
DATABASE_URL=sqlite:///./backend/darshanai.db

# 3. JWT Authentication & Security
SECRET_KEY=change_this_to_a_random_cryptographically_secure_64_char_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 4. CORS Allowed Origins (Comma-Separated for Production Domains)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://yourdomain.com,https://app.yourdomain.com

# 5. Production Server Settings
PORT=8000
HOST=0.0.0.0
WORKERS=4
