# Frontend Client Environment Configuration

# Production Backend API URL:
# For standalone frontend deployment (e.g. Vercel/Netlify), set to your deployed backend:
# VITE_API_URL=https://darshanai-backend.onrender.com/api
VITE_API_URL=https://darshanai-backend.onrender.com/api
VITE_API_BASE_URL=https://darshanai-backend.onrender.com/api

# Optional: Dedicated WebSocket Endpoint for Live Telemetry (e.g. wss://darshanai-backend.onrender.com)
# VITE_WS_URL=wss://darshanai-backend.onrender.com
VITE_WS_URL=
